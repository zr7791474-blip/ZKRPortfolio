# Public contact details rendered on the site.
# All NEXT_PUBLIC_* vars are exposed to the browser — do not put secrets here.

NEXT_PUBLIC_CONTACT_EMAIL=zr7791474@gmail.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/zr7791474-blip
NEXT_PUBLIC_X_URL=https://x.com/zkr_ad
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/212657516301
NEXT_PUBLIC_LOCATION=Casablanca, Morocco

# Optional: real email delivery via Resend (recommended — see README "Contact form")
# 1. Sign up free at https://resend.com and create an API key.
# 2. Paste the API key below as RESEND_API_KEY. Emails will arrive at
#    CONTACT_TO_EMAIL (or NEXT_PUBLIC_CONTACT_EMAIL if that's not set).
# 3. For production sending, verify your own domain in Resend and set
#    RESEND_FROM_EMAIL to an address on it (e.g. "ZKR <contact@yourdomain.com>").
#    Until then, the default "onboarding@resend.dev" sender works for testing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional alternative: forward to any webhook (Formspree, your own API, etc.)
# instead of Resend. Only used if RESEND_API_KEY above is not set.
CONTACT_FORM_ENDPOINT=
